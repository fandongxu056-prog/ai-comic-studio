# ── App ──
APP_NAME=AI Comic Studio
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-random-string

# ── Database ──
POSTGRES_USER=comic
POSTGRES_PASSWORD=comic123
POSTGRES_DB=comic_studio
DATABASE_URL=postgresql+asyncpg://comic:comic123@db:5432/comic_studio

# ── Redis ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=comic-studio

# ── LLM (fill in your keys) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-20251001

# ── Image Generation ──
IMAGE_PROVIDER=openai
IMAGE_MODEL=dall-e-3

# ── Video Generation ──
VIDEO_PROVIDER=
VIDEO_MODEL=

# ── TTS ──
TTS_PROVIDER=openai
TTS_MODEL=tts-1-hd
TTS_DEFAULT_VOICE=alloy

# ── Budget ──
MAX_BUDGET_PER_PROJECT_USD=50.0
BUDGET_MODE=warn

# ── Auth ──
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
